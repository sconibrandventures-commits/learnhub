# ===========================================================================
#  LearnHub — configuration
#  Copy this file to  .env  and fill in your Appwrite Cloud details.
#  Get them from: https://cloud.appwrite.io  ->  your project  ->  Settings
# ===========================================================================

# --- Appwrite -------------------------------------------------------------
# For Appwrite Cloud this is always:  https://cloud.appwrite.io/v1
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Project ID, e.g.  66f1a2b3c4d5e6f7a8b9
VITE_APPWRITE_PROJECT_ID=

# --- Demo mode ------------------------------------------------------------
# true  = the portal runs entirely in your browser with sample data, so you
#         can click through every screen without connecting Appwrite.
# false = the portal talks to your real Appwrite project.
#
# Leave this as "true" until you have created your Appwrite project.
# As soon as you fill in VITE_APPWRITE_PROJECT_ID above, flip this to false.
VITE_DEMO_MODE=true

# --- Optional -------------------------------------------------------------
# Shown in the footer / browser tab. Cosmetic only.
VITE_APP_NAME=LearnHub
