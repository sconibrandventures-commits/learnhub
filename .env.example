# ===========================================================================
#  LearnHub — configuration
#  Copy this file to  .env  and fill in your Appwrite Cloud details.
#  Get them from: https://cloud.appwrite.io  ->  your project  ->  Settings
# ===========================================================================

# --- Appwrite -------------------------------------------------------------
# Copy the exact "API Endpoint" from your project's Settings in Appwrite Console.
# Appwrite Cloud projects are region-specific, for example:
#   Frankfurt (EU):      https://fra.cloud.appwrite.io/v1
#   London (UK):         https://lon.cloud.appwrite.io/v1
#   New York (US East):  https://nyc.cloud.appwrite.io/v1
#   San Francisco (US):  https://sfo.cloud.appwrite.io/v1
#   Singapore (AP):      https://sgp.cloud.appwrite.io/v1
#   Sydney (Oceania):    https://syd.cloud.appwrite.io/v1
# If you leave the generic https://cloud.appwrite.io/v1 on a regional project,
# Appwrite will reject requests with "Project is not accessible in this region".
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1

# Project ID, e.g.  66f1a2b3c4d5e6f7a8b9
VITE_APPWRITE_PROJECT_ID=

# API Key (ONLY needed once when running `npm run setup:appwrite`)
# Create in Appwrite Console -> Project Settings -> View API Keys
# Scopes needed: databases, collections, attributes, buckets, teams, users
APPWRITE_API_KEY=

# --- Demo mode ------------------------------------------------------------
# true  = the portal runs entirely in your browser with sample data, so you
#         can click through every screen without connecting Appwrite.
# false = the portal talks to your real Appwrite project.
#
# Leave this as "true" until you have created your Appwrite project.
# As soon as you fill in VITE_APPWRITE_PROJECT_ID above, flip this to false.
VITE_DEMO_MODE=false

# --- Optional -------------------------------------------------------------
# Shown in the footer / browser tab. Cosmetic only.
VITE_APP_NAME=LearnHub
